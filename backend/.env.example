# Copie para .env e ajuste.

# MySQL (banco AcomPaci_db). Sem esta linha, usa um SQLite local (acompaci.db).
DATABASE_URL=mysql+pymysql://root:SUA_SENHA@127.0.0.1:3306/AcomPaci_db?charset=utf8mb4

# Chave que assina o login da equipe (JWT). Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
# Duração do login, em horas (um plantão).
JWT_HORAS=12

# Onde o front-end roda (vai no link do e-mail e libera o CORS).
FRONTEND_URL=http://localhost:5173

# E-mail do token. Deixe SMTP_HOST vazio para só imprimir o e-mail no terminal.
# Exemplo com Gmail: crie uma "senha de app" em myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AcomPaci <seu-email@gmail.com>
SMTP_TLS=starttls
